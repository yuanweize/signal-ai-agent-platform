# ============================================================
# Signal Market Bot — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ----- Release Version (optional override) -----
# Source of truth is backend/pyproject.toml [project].version.
# APP_VERSION is only used when you explicitly need a temporary override.
APP_VERSION=

# ----- Signal API Gateway (secured-signal-api) -----
SIGNAL_API_URL=http://your-API-URL-here:8880
SIGNAL_API_TOKEN=your-bearer-token-here
SIGNAL_PHONE_NUMBER=+420123456789

# ----- Feature Toggles (each module is independent) -----
# Set to false to disable a module without removing config
FEATURE_AI_ENABLED=true
FEATURE_MARKET_ENABLED=true

# ----- AI Provider (OpenAI-compatible API) -----
# Only used when FEATURE_AI_ENABLED=true
# Supports: OpenAI, Azure OpenAI, Tailscale AI Gateway,
#           OpenRouter, LocalAI, Ollama, vLLM, etc.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-api-key-here
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
# Max messages to include in AI context window
AI_CONTEXT_MESSAGES=20

# ----- Database -----
# SQLite (default, recommended for single-node):
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# PostgreSQL (optional, for production scale):
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/signalbot

# ----- Admin Dashboard Security -----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Generate with: python3 -c "import base64,secrets; print(base64.b32encode(secrets.token_bytes(20)).decode())"
# Or inside Docker: docker compose exec backend python -c "import pyotp; print(pyotp.random_base32())"
ADMIN_TOTP_SECRET=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-random-secret

# ----- Bot Behavior -----
BOT_DEFAULT_LANGUAGE=cs
BOT_NAME=MarketBot
# System prompt injected into every AI conversation
BOT_SYSTEM_PROMPT=Jsi přátelský prodejní asistent. Odpovídej přirozeně česky, jako bys byl skutečný člověk. Nikdy neprozrazuj, že jsi AI.

# ----- Logging -----
LOG_LEVEL=INFO
